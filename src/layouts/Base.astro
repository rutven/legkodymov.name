---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: string;
}

const { title, description, lang = "en" } = Astro.props;
const year = new Date().getFullYear();
const canonical = Astro.url.pathname.startsWith("/404") ? null : new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="site-name">Sergei Legkodymov</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {year} Sergei Legkodymov</span>
      <a href="mailto:apps@legkodymov.name">apps@legkodymov.name</a>
      <a href="/privacy/">Privacy</a>
    </footer>
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "44742bd62d304616b167a8eeb5c8ddc8"}'></script>
  </body>
</html>

---
import Base from "../layouts/Base.astro";
import { developer } from "../lib/developer";
import { useStrings } from "../i18n";

const s = useStrings(Astro.currentLocale);
---

<Base title={s.sitePrivacyTitle} description={s.sitePrivacyDescription}>
  <h1>{s.sitePrivacyHeading}</h1>
  <p>
    {s.sitePrivacyBody} <a href={`mailto:${developer.email}`}>{developer.email}</a>.
  </p>
</Base>
